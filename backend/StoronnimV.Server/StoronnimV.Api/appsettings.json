{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "RateLimiterOptions": {
    "StatusCode": 429,
    "Policies": [
      {
        "PolicyName": "UserLimitPerMinute",
        "Limit": 60,
        "Expiration": "00:01:00"
      },
      {
        "PolicyName": "AdminLimitPerMinute",
        "Limit": 100,
        "Expiration": "00:01:00"
      }
    ]
  },
  
  "CookieOptions": {
    "HttpOnly": true,
    "Secure": true,
    "SameSite": "None",
    "ExpiresInHours": 1
  }
}
